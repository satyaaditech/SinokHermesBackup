# Baris fstab untuk USB auto-mount (satu baris per drive, ganti UUID & mount point)
# UUID didapat dari: lsblk -f /dev/sdX
# Sintaks validasi: findmnt --verify --tab-file <file>

UUID=<UUID> /mnt/<name> exfat nofail,noatime,nosuid,nodev,umask=000,x-systemd.automount,x-systemd.idle-timeout=600,x-systemd.device-timeout=5 0 0
UUID=<UUID> /mnt/<name> vfat  nofail,noatime,nosuid,nodev,umask=000,x-systemd.automount,x-systemd.idle-timeout=600,x-systemd.device-timeout=5 0 0
