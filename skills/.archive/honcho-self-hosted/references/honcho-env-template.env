# Honcho .env template for OpenRouter / OmniRoute
# Copy to ~/honcho/.env and replace the API key.
#
# Uses google/gemini-2.0-flash-001 — cheapest function-calling model on OpenRouter.
# For other OpenRouter models: https://openrouter.ai/models?q=gemini+flash

LLM_OPENAI_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# --- Deriver (background user model builder) ---
DERIVER_MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# --- Dialectic (all 5 reasoning levels — MUST override all) ---
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# --- Summary ---
SUMMARY_MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# --- Dream (deduction + induction) ---
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_INDUCTION_MODEL_CONFIG__MODEL=google/gemini-2.0-flash-001
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# --- Embedding ---
EMBEDDING_MODEL_CONFIG__MODEL=google/text-embedding-004
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
